{$DOMINIO} {
	encode gzip
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /admin* {
		reverse_proxy api:8000
	}
	redir /app /app/
	handle_path /app/* {
		root * /srv/app
		try_files {path} {path}.html /index.html
		file_server
	}
	handle_path /static/* {
		root * /srv/static
		file_server
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}

{
  "installCommand": "cd .. && npm ci",
  "buildCommand": "npx expo export -p web --output-dir dist",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://kamby-api.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
